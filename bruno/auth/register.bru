meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/auth/register
  body: none
  auth: none
}

body:json {
  {
    "email": "test@docuflow.dev",
    "password": "password123",
    "workspaceName": "My Workspace"
  }
}

vars:pre-request {
  BASE_URL: 
}

assert {
  res.status: eq 201
  res.body.token: isPresent
}

script:post-response {
  bru.setVar("authToken", res.body.token);
}
